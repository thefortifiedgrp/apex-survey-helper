{
  "name": "@apextelemed/survey-core",
  "version": "0.1.0",
  "description": "Framework-agnostic state machine and API client for the Apex Telemed survey-v2 embed flow.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thefortifiedgrp/apex-survey-helper.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/thefortifiedgrp/apex-survey-helper/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/thefortifiedgrp/apex-survey-helper/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "apex",
    "telemed",
    "survey",
    "intake",
    "telehealth"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  }
}
